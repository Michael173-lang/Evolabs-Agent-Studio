* text=auto

# cmd.exe requires CRLF and must not receive a UTF-8 BOM.
*.bat text eol=crlf
*.cmd text eol=crlf

# Windows PowerShell 5.1 is most reliable with CRLF; source readers explicitly use UTF-8.
*.ps1 text eol=crlf

*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
